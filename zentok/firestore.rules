rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/zenAdmins/$(request.auth.uid));
    }

    // Admins are added by hand in the Firebase Console. The app can never write here.
    match /zenAdmins/{a} {
      allow get: if signedIn() && request.auth.uid == a;
      allow write: if false;
    }

    // Profiles. Only admins can change "verified".
    match /users/{u} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == u
        && request.resource.data.get('verified', false) == false;
      allow update: if signedIn() && (
        isAdmin() ||
        (request.auth.uid == u
          && request.resource.data.get('verified', false) == resource.data.get('verified', false)));
    }
    match /posts/{p} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.author == request.auth.uid;
      allow update: if signedIn() && resource.data.author == request.auth.uid
        && request.resource.data.author == resource.data.author;
      allow delete: if signedIn() && resource.data.author == request.auth.uid;
    }
    match /likes/{l} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /comments/{c} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /follows/{f} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.from == request.auth.uid;
      allow delete: if signedIn() && resource.data.from == request.auth.uid;
    }
    // Private bookmarks: only the owner can see or change them.
    match /saves/{s} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }
    // Notifications: anyone can send one, only the receiver can read, mark read or delete.
    match /notifs/{n} {
      allow read, delete: if signedIn() && resource.data.to == request.auth.uid;
      allow create, update: if signedIn() && request.resource.data.from == request.auth.uid;
      allow update: if signedIn() && resource.data.to == request.auth.uid;
    }

    // Likes on comments
    match /clikes/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    // Private messages: only the two people in the chat can read or write.
    match /chats/{c} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2;
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      match /messages/{m} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(c)).data.members;
        allow create: if signedIn() && request.resource.data.from == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(c)).data.members
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500;
      }
    }

    // Groups: created as "pending", opened by an admin. Members chat inside.
    match /groups/{g} {
      allow read: if signedIn() && (resource.data.status == 'approved'
        || resource.data.owner == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 40;
      allow update: if isAdmin() || (signedIn() && resource.data.status == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && (
          (request.resource.data.members.toSet().difference(resource.data.members.toSet()).hasOnly([request.auth.uid])
            && resource.data.members.toSet().difference(request.resource.data.members.toSet()).size() == 0)
          ||
          (resource.data.members.toSet().difference(request.resource.data.members.toSet()).hasOnly([request.auth.uid])
            && request.resource.data.members.toSet().difference(resource.data.members.toSet()).size() == 0)));
      allow delete: if isAdmin();
      match /messages/{m} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(g)).data.members;
        allow create: if signedIn() && request.resource.data.from == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(g)).data.members
          && get(/databases/$(database)/documents/groups/$(g)).data.status == 'approved'
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500;
        allow delete: if isAdmin();
      }
    }
    // Video ads: everyone signed in can see them, only admins manage them.
    match /ads/{a} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
