<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>About — Zenova Study</title>
<meta name="description" content="Zenova Study is a student-focused educational platform helping Nigerian students learn smarter, prepare effectively, and achieve more.">
<link rel="icon" type="image/png" href="/logo.png">
<link rel="apple-touch-icon" href="/logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">
<style>
  :root{
    --navy-deep:#0A1628;
    --navy:#0B1D3A;
    --blue:#2563EB;
    --blue-bright:#1E5FFF;
    --amber:#F5A524;
    --white:#FFFFFF;
    --paper:#F7F9FC;
    --ink:#0A1628;
    --ink-soft:#54607C;
    --ink-faint:#8592AD;
    --line:#E6EAF3;
    --radius:18px;
    --sora:'Sora', sans-serif;
    --dm:'DM Sans', sans-serif;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    font-family:var(--dm);
    color:var(--ink);
    background:var(--white);
    -webkit-font-smoothing:antialiased;
  }
  a{color:inherit;text-decoration:none;}
  img{max-width:100%;display:block;}
  .wrap{max-width:1140px;margin:0 auto;padding:0 24px;}

  /* ---------- HEADER ---------- */
  header{
    position:sticky;top:0;z-index:100;
    background:rgba(255,255,255,0.92);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  .nav-row{display:flex;align-items:center;justify-content:space-between;height:70px;}
  .logo{
    font-family:var(--sora);font-weight:800;font-size:1.1rem;
    letter-spacing:0.01em;color:var(--navy-deep);
    display:flex;align-items:center;gap:10px;
  }
  .logo-mark{
    width:30px;height:30px;border-radius:8px;
    background:linear-gradient(135deg,var(--blue-bright),var(--navy));
    display:flex;align-items:center;justify-content:center;
    color:#fff;font-family:var(--sora);font-weight:800;font-size:0.9rem;
  }
  .logo-mark-img{width:32px;height:32px;object-fit:contain;}
  .footer-logo-img{width:34px;height:34px;object-fit:contain;}
  .social-list{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:12px;}
  .social-list a{display:flex;align-items:center;gap:10px;font-size:0.89rem;}
  .social-list .icon{font-size:1.05rem;line-height:1;width:20px;text-align:center;}
  nav.desktop-nav{display:flex;align-items:center;gap:32px;}
  nav.desktop-nav a{
    font-family:var(--sora);font-weight:600;font-size:0.9rem;
    color:var(--ink-soft);transition:color .15s ease;
  }
  nav.desktop-nav a:hover{color:var(--blue-bright);}
  .cta-btn{
    font-family:var(--sora);font-weight:700;font-size:0.86rem;
    background:var(--blue-bright);color:#fff;
    padding:10px 20px;border-radius:999px;border:none;cursor:pointer;
    transition:transform .15s ease, box-shadow .15s ease;
  }
  .cta-btn:hover{transform:translateY(-1px);box-shadow:0 10px 20px -10px rgba(30,95,255,0.6);}
  .cta-btn.outline{background:transparent;color:var(--navy-deep);border:1px solid var(--line);}
  .cta-btn.outline:hover{border-color:var(--blue-bright);color:var(--blue-bright);box-shadow:none;}
  .header-actions{display:flex;align-items:center;gap:16px;}

  .hamburger{
    display:none;flex-direction:column;justify-content:center;gap:5px;
    width:36px;height:36px;border:none;background:none;cursor:pointer;padding:0;
  }
  .hamburger span{width:21px;height:2px;background:var(--navy-deep);border-radius:2px;transition:transform .25s ease, opacity .25s ease;}
  .hamburger.open span:nth-child(1){transform:translateY(7px) rotate(45deg);}
  .hamburger.open span:nth-child(2){opacity:0;}
  .hamburger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg);}

  .mobile-panel{
    display:none;flex-direction:column;background:var(--white);border-bottom:1px solid var(--line);
    max-height:0;overflow:hidden;transition:max-height .3s ease;
  }
  .mobile-panel.open{max-height:520px;}
  .mobile-panel a{
    font-family:var(--sora);font-weight:600;font-size:1rem;color:var(--navy-deep);
    padding:15px 24px;border-bottom:1px solid var(--line);
  }
  .mobile-panel .cta-btn{margin:16px 24px 20px;text-align:center;}

  @media (max-width:860px){
    nav.desktop-nav{display:none;}
    .header-actions .cta-btn{display:none;}
    .hamburger{display:flex;}
    .mobile-panel{display:flex;}
  }

  /* ---------- HERO ---------- */
  .hero{padding:104px 0 88px;text-align:center;position:relative;overflow:hidden;}
  .hero::before{
    content:"";position:absolute;top:-180px;left:50%;transform:translateX(-50%);
    width:900px;height:500px;
    background:radial-gradient(closest-side, rgba(37,99,235,0.10), transparent 72%);
    pointer-events:none;
  }
  .hero-inner{position:relative;z-index:1;max-width:720px;margin:0 auto;}
  .eyebrow{
    font-family:var(--sora);font-weight:600;font-size:0.78rem;letter-spacing:0.06em;
    text-transform:uppercase;color:var(--blue-bright);
    display:inline-flex;align-items:center;gap:8px;margin-bottom:22px;
  }
  .eyebrow .dot{width:6px;height:6px;border-radius:50%;background:var(--amber);}
  .hero h1{
    font-family:var(--sora);font-weight:800;font-size:clamp(2.1rem,4.6vw,3.2rem);
    line-height:1.14;margin:0 0 20px;letter-spacing:-0.01em;color:var(--navy-deep);
  }
  .hero p.lead{font-size:1.08rem;line-height:1.65;color:var(--ink-soft);max-width:540px;margin:0 auto 34px;}
  .hero-ctas{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-bottom:28px;}
  .hero-sub{
    font-family:var(--sora);font-weight:600;font-size:0.82rem;letter-spacing:0.08em;
    text-transform:uppercase;color:var(--ink-faint);
  }
  @media (max-width:860px){.hero{padding:68px 0 56px;}}

  /* ---------- SECTIONS ---------- */
  section{padding:84px 0;}
  .section-head{max-width:600px;margin:0 auto 48px;text-align:center;}
  .section-eyebrow{
    font-family:var(--sora);font-weight:700;font-size:0.75rem;letter-spacing:0.08em;
    text-transform:uppercase;color:var(--blue-bright);margin-bottom:12px;display:block;
  }
  .section-head h2{
    font-family:var(--sora);font-weight:800;font-size:clamp(1.6rem,3vw,2.15rem);
    margin:0 0 14px;color:var(--navy-deep);letter-spacing:-0.01em;
  }
  .section-head p{font-size:1rem;line-height:1.65;color:var(--ink-soft);margin:0;}
  .section-link{
    font-family:var(--sora);font-weight:600;font-size:0.9rem;color:var(--blue-bright);
    display:inline-flex;align-items:center;gap:6px;margin-top:18px;
  }
  .section-link svg{transition:transform .15s ease;}
  .section-link:hover svg{transform:translateX(3px);}
  .paper{background:var(--paper);}

  /* Ecosystem cards */
  .eco-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;}
  .eco-card{
    background:#fff;border:1px solid var(--line);border-radius:var(--radius);
    padding:30px 26px;transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  }
  .eco-card:hover{transform:translateY(-3px);box-shadow:0 22px 36px -22px rgba(10,22,40,0.22);border-color:#D3E0FA;}
  .eco-icon{
    width:46px;height:46px;border-radius:12px;display:flex;align-items:center;justify-content:center;
    font-size:1.25rem;margin-bottom:18px;
  }
  .eco-card h3{font-family:var(--sora);font-weight:700;font-size:1.1rem;margin:0 0 10px;color:var(--navy-deep);}
  .eco-card p{font-size:0.92rem;line-height:1.6;color:var(--ink-soft);margin:0 0 18px;}
  .eco-card a.go{font-family:var(--sora);font-weight:600;font-size:0.86rem;color:var(--blue-bright);display:inline-flex;align-items:center;gap:6px;}
  .eco-card a.go svg{transition:transform .15s ease;}
  .eco-card:hover a.go svg{transform:translateX(3px);}

  /* Why Zenova */
  .why-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;}
  .why-item{padding:4px;}
  .why-num{
    font-family:var(--sora);font-weight:800;font-size:0.78rem;color:var(--blue-bright);
    background:#EAF0FF;width:32px;height:32px;border-radius:9px;
    display:flex;align-items:center;justify-content:center;margin-bottom:16px;
  }
  .why-item h3{font-family:var(--sora);font-weight:700;font-size:1rem;margin:0 0 8px;color:var(--navy-deep);}
  .why-item p{font-size:0.88rem;line-height:1.6;color:var(--ink-soft);margin:0;}

  /* Subjects */
  .subject-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}
  .subject-card{
    border:1px solid var(--line);border-radius:var(--radius);padding:26px;
    background:#fff;border-top:3px solid var(--track-color,#2563EB);
  }
  .subject-card h3{font-family:var(--sora);font-weight:700;font-size:1rem;margin:0 0 10px;color:var(--navy-deep);}
  .subject-card p{font-size:0.88rem;line-height:1.6;color:var(--ink-soft);margin:0;}

  /* Resources */
  .resource-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
  .resource-card{
    border:1px solid var(--line);border-radius:var(--radius);padding:24px 22px;background:#fff;
    transition:border-color .18s ease, transform .18s ease;
  }
  .resource-card:hover{border-color:#D3E0FA;transform:translateY(-2px);}
  .resource-card h3{font-family:var(--sora);font-weight:700;font-size:0.98rem;margin:0 0 8px;color:var(--navy-deep);}
  .resource-card p{font-size:0.86rem;line-height:1.55;color:var(--ink-soft);margin:0;}

  /* Competition feature banner */
  .comp-banner{
    background:linear-gradient(135deg,var(--navy-deep),#12275A);
    border-radius:28px;padding:64px 48px;text-align:center;color:#fff;
  }
  .comp-banner .section-eyebrow{color:#8FB0FF;}
  .comp-banner h2{
    font-family:var(--sora);font-weight:800;font-size:clamp(1.6rem,3.2vw,2.2rem);margin:0 0 14px;color:#fff;
  }
  .comp-banner p{color:#C4D2F0;font-size:1rem;line-height:1.65;max-width:520px;margin:0 auto 30px;}

  /* Testimonials */
  .testimonial-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;}
  .testimonial-card{
    background:var(--paper);border-radius:var(--radius);padding:28px;border:1px solid var(--line);
  }
  .testimonial-card p{
    font-family:var(--sora);font-weight:500;font-size:0.98rem;line-height:1.6;color:var(--navy-deep);margin:0;
  }
  .testimonial-card p::before{content:"“";color:var(--blue-bright);font-weight:800;}
  .testimonial-card p::after{content:"”";color:var(--blue-bright);font-weight:800;}
  .testimonial-note{
    text-align:center;font-size:0.82rem;color:var(--ink-faint);margin-top:20px;font-style:italic;
  }

  /* Final CTA */
  .final-cta{
    background:linear-gradient(135deg,var(--navy-deep),#0F2450);
    border-radius:28px;padding:64px 48px;text-align:center;color:#fff;
  }
  .final-cta h2{font-family:var(--sora);font-weight:800;font-size:clamp(1.7rem,3.4vw,2.3rem);margin:0 0 14px;}
  .final-cta p{color:#C4D2F0;font-size:1rem;max-width:480px;margin:0 auto 30px;line-height:1.6;}
  .final-cta .tagline{
    font-family:var(--sora);font-weight:600;font-size:0.82rem;letter-spacing:0.08em;
    text-transform:uppercase;color:#8FA3CC;margin-top:26px;
  }

  /* Footer */
  footer{background:var(--navy-deep);color:#8FA3CC;padding:56px 0 32px;}
  .footer-grid{display:grid;grid-template-columns:1.4fr repeat(3,1fr);gap:32px;margin-bottom:40px;}
  .footer-logo{font-family:var(--sora);font-weight:800;font-size:1.05rem;color:#fff;margin-bottom:10px;display:flex;align-items:center;gap:10px;}
  footer p.desc{font-size:0.88rem;line-height:1.6;max-width:280px;}
  footer h4{font-family:var(--sora);font-weight:700;font-size:0.8rem;letter-spacing:0.05em;text-transform:uppercase;color:#fff;margin:0 0 16px;}
  footer ul{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:10px;}
  footer a{font-size:0.89rem;transition:color .15s ease;}
  footer a:hover{color:#fff;}
  .footer-bottom{
    border-top:1px solid rgba(255,255,255,0.08);padding-top:24px;
    display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:0.82rem;
  }

  @media (max-width:860px){
    .eco-grid{grid-template-columns:1fr;}
    .why-grid{grid-template-columns:1fr 1fr;}
    .subject-grid{grid-template-columns:1fr;}
    .resource-grid{grid-template-columns:1fr 1fr;}
    .testimonial-grid{grid-template-columns:1fr;}
    .footer-grid{grid-template-columns:1fr 1fr;}
    .comp-banner,.final-cta{padding:48px 28px;}
    section{padding:60px 0;}
  }
  @media (max-width:520px){
    .why-grid{grid-template-columns:1fr;}
    .resource-grid{grid-template-columns:1fr;}
    .footer-grid{grid-template-columns:1fr;}
  }

  /* ---------- JAMB 2027 page extras ---------- */
  .flow-line{
    display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:10px;
    font-family:var(--sora);font-weight:700;font-size:0.95rem;color:var(--blue-bright);
    margin-top:10px;
  }
  .flow-line .sep{color:var(--ink-faint);font-weight:400;}

  .feat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;}
  .feat-card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:28px 24px;transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease;}
  .feat-card:hover{transform:translateY(-3px);box-shadow:0 20px 34px -20px rgba(10,22,40,0.2);border-color:#D3E0FA;}
  .feat-icon{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.2rem;margin-bottom:16px;background:#EAF0FF;}
  .feat-card h3{font-family:var(--sora);font-weight:700;font-size:1.02rem;margin:0 0 8px;color:var(--navy-deep);}
  .feat-card p{font-size:0.88rem;line-height:1.6;color:var(--ink-soft);margin:0;}

  .subject-list-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;}
  .subject-item{border:1px solid var(--line);border-radius:14px;padding:20px;background:#fff;}
  .subject-item h3{font-family:var(--sora);font-weight:700;font-size:0.95rem;margin:0 0 8px;color:var(--navy-deep);}
  .subject-item p{font-size:0.84rem;line-height:1.55;color:var(--ink-soft);margin:0;}
  .fine-print{font-size:0.8rem;line-height:1.6;color:var(--ink-faint);font-style:italic;max-width:680px;margin:22px auto 0;text-align:center;}

  .step-row{display:grid;grid-template-columns:repeat(5,1fr);gap:18px;}
  .step-card{padding:4px;}
  .step-card .why-num{background:var(--blue-bright);color:#fff;}

  .checklist{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:1fr 1fr;gap:14px 28px;max-width:600px;margin:28px auto 0;}
  .checklist li{display:flex;align-items:flex-start;gap:10px;font-size:0.92rem;color:var(--ink-soft);}
  .checklist li::before{content:"✓";color:var(--blue-bright);font-weight:800;flex-shrink:0;}

  .mini-banner{
    border:1px solid var(--line);border-radius:var(--radius);
    padding:40px 36px;display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;
    background:#fff;
  }
  .mini-banner .mb-text h3{font-family:var(--sora);font-weight:700;font-size:1.15rem;margin:0 0 8px;color:var(--navy-deep);}
  .mini-banner .mb-text p{font-size:0.92rem;color:var(--ink-soft);margin:0;max-width:440px;}

  .faq-item{border-bottom:1px solid var(--line);}
  .faq-q{
    width:100%;text-align:left;background:none;border:none;cursor:pointer;
    padding:22px 4px;display:flex;align-items:center;justify-content:space-between;gap:16px;
    font-family:var(--sora);font-weight:700;font-size:0.98rem;color:var(--navy-deep);
  }
  .faq-q .plus{font-size:1.2rem;color:var(--blue-bright);transition:transform .2s ease;flex-shrink:0;}
  .faq-item.open .faq-q .plus{transform:rotate(45deg);}
  .faq-a{max-height:0;overflow:hidden;transition:max-height .25s ease;}
  .faq-a p{font-size:0.9rem;line-height:1.65;color:var(--ink-soft);padding:0 4px 22px;margin:0;}
  .faq-wrap{max-width:760px;margin:0 auto;}

  .important-note{
    background:#FFF8E8;border:1px solid #F5D98A;border-radius:16px;
    padding:24px 26px;max-width:760px;margin:0 auto;
  }
  .important-note h3{font-family:var(--sora);font-weight:700;font-size:0.92rem;margin:0 0 8px;color:#8A5A00;}
  .important-note p{font-size:0.86rem;line-height:1.6;color:#8A5A00;margin:0;}

  .final-cta .cta-row{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;}
  .final-cta .cta-btn.outline{background:rgba(255,255,255,0.06);color:#fff;border-color:rgba(255,255,255,0.28);}

  @media (max-width:860px){
    .feat-grid{grid-template-columns:1fr 1fr;}
    .subject-list-grid{grid-template-columns:1fr 1fr;}
    .step-row{grid-template-columns:1fr 1fr;}
    .checklist{grid-template-columns:1fr;}
    .mini-banner{flex-direction:column;text-align:center;}
  }
  @media (max-width:520px){
    .feat-grid{grid-template-columns:1fr;}
    .subject-list-grid{grid-template-columns:1fr;}
    .step-row{grid-template-columns:1fr;}
  }

  /* ---------- About page extras ---------- */
  .prose{max-width:720px;margin:0 auto;}
  .prose p{font-size:1rem;line-height:1.75;color:var(--ink-soft);margin:0 0 18px;}
  .prose p:last-child{margin-bottom:0;}
  .prose strong{color:var(--navy-deep);}

  .founder-card{
    display:grid;grid-template-columns:120px 1fr;gap:28px;align-items:start;
    background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:32px;max-width:760px;margin:0 auto;
  }
  .founder-avatar{
    width:120px;height:120px;border-radius:50%;
    background:linear-gradient(135deg,var(--blue-bright),var(--navy));
    display:flex;align-items:center;justify-content:center;
    color:#fff;font-family:var(--sora);font-weight:800;font-size:2.2rem;flex-shrink:0;
  }
  .founder-name{font-family:var(--sora);font-weight:800;font-size:1.3rem;color:var(--navy-deep);margin:0 0 4px;}
  .founder-title{font-family:var(--sora);font-weight:600;font-size:0.88rem;color:var(--blue-bright);margin:0 0 4px;}
  .founder-meta{font-size:0.82rem;color:var(--ink-faint);margin:0 0 16px;}
  .founder-card p.bio{font-size:0.92rem;line-height:1.65;color:var(--ink-soft);margin:0 0 12px;}

  .quote-block{
    max-width:640px;margin:0 auto;text-align:center;
    background:linear-gradient(135deg,var(--navy-deep),#12275A);
    border-radius:var(--radius);padding:44px 40px;color:#fff;
  }
  .quote-block p{font-family:var(--sora);font-weight:600;font-size:1.15rem;line-height:1.55;margin:0 0 18px;}
  .quote-block cite{font-style:normal;font-size:0.85rem;color:#8FA3CC;}

  .timeline{max-width:640px;margin:0 auto;position:relative;padding-left:32px;}
  .timeline::before{content:"";position:absolute;left:7px;top:6px;bottom:6px;width:2px;background:var(--line);}
  .tl-item{position:relative;padding-bottom:34px;}
  .tl-item:last-child{padding-bottom:0;}
  .tl-item::before{
    content:"";position:absolute;left:-32px;top:4px;width:16px;height:16px;border-radius:50%;
    background:var(--blue-bright);border:3px solid #fff;box-shadow:0 0 0 2px var(--blue-bright);
  }
  .tl-date{font-family:var(--sora);font-weight:700;font-size:0.76rem;letter-spacing:0.05em;text-transform:uppercase;color:var(--blue-bright);margin-bottom:6px;}
  .tl-title{font-family:var(--sora);font-weight:700;font-size:1.02rem;color:var(--navy-deep);margin:0 0 6px;}
  .tl-desc{font-size:0.9rem;line-height:1.6;color:var(--ink-soft);margin:0;}

  @media (max-width:600px){
    .founder-card{grid-template-columns:1fr;text-align:center;}
    .founder-avatar{margin:0 auto;}
  }

  .contact-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;}
  .contact-card{
    background:#fff;border:1px solid var(--line);border-radius:14px;padding:20px 18px;
    display:flex;flex-direction:column;align-items:center;text-align:center;gap:8px;
    transition:transform .15s ease, box-shadow .15s ease, border-color .15s ease;
  }
